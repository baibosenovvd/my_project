# PostgreSQL. Сервер — по итогам консультации юриста (ТЗ, раздел 8): безопасный вариант — в Казахстане
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/az_analytics"

# Ключ для HMAC-SHA256 от ИИН. Длинная случайная строка: openssl rand -hex 32
# Если ключ потерять или сменить, хэши в базе перестанут совпадать с новыми списками
IIN_HMAC_SECRET=""

# Секретный ключ вебхука Google Формы (заголовок запроса к /api/ingest/form)
FORM_WEBHOOK_SECRET=""
